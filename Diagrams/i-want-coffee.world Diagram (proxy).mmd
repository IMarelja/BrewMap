graph TB
    subgraph docker["Docker Compose"]
        subgraph public["Public network"]
            proxy["Nginx reverse proxy"]
            webapp["Webapp Container"]
        end
        subgraph bridge["(public + internal)"]
            api["API Container"]
        end
        subgraph internal["Internal network"]
            mongodb[("MongoDB Container")]
        end 
    end
    
    external["Client"]
    mobile_app["Flutter App"]
    
    external -->|HTTP| proxy 
    external --> mobile_app
    mobile_app -->|HTTP/REST| proxy
    proxy -->|/| webapp
    proxy -->|/api| api
    webapp -->|HTTP/REST| proxy
    %% webapp -->|API Calls| api
    api -->|Query/Update| mongodb
    
    style webapp fill:#4A90E2
    style api fill:#4A90E2
    style mongodb fill:#555555,color:#fff
    style docker fill:#f9f9f9,stroke:#333
    style external fill:#90EE90
    style mobile_app fill:#b1ecff
    style proxy fill:#3d9153