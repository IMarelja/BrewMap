# Duplicate Gradle wrapper + version catalog inside app/ (root-level copies are canonical)
app/gradlew
app/gradlew.bat
app/settings.gradle.kts
app/gradle/wrapper/
app/gradle/libs.versions.toml

# Kotlin compiler session files
.kotlin/
**/.kotlin/

