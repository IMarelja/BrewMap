# BrewMap MongoDB — environment variables
# Copy this file to .env and fill in your values before running docker compose up

MONGO_ROOT_USER=admin               # default "admin"
MONGO_ROOT_PASSWORD=changeme        # default "changeme" CHANGE THIS before running in any shared environment
MONGO_PORT=27017                    # default "27017"

# BrewMap API
# 127.0.0.1 for local only access
# 0.0.0.0 for global access
BIND_IP=127.0.0.1 
HTTP_PORT=5239
HTTPS_PORT=7000

# WebApp (Frontend)

# Mobile App (MobileApp)

# [APP MODES]
# - HARD_CODE = (offline) data is fully stored on the app
# - API = (online) data is purely fetched from the BrewMapAPI
# - PERSISTENT = (online/offline) data fetched from the API, but exists in Android cache for some time
APP_MODE=PERSISTENT

# Connection url to the API
# http(s)://<insert url>:<insert port>/api
BIND_API_URL=http://172.20.10.3:5239/api
